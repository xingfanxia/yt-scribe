{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Scribe",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "homepage_url": "https://github.com/xingfanxia/yt-scribe",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://www.bilibili.com/*"],
      "js": [
        "src/shared/core.js",
        "src/shared/dom.js",
        "src/shared/store.js",
        "src/content/extract.js",
        "src/content/extract-bilibili.js",
        "src/content/content.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "unlimitedStorage", "scripting", "sidePanel", "activeTab", "tabs", "clipboardWrite"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.bilibili.com/*",
    "https://api.anthropic.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "copy-transcript": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "__MSG_cmdCopy__"
    },
    "toggle-chat": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "__MSG_cmdChat__"
    }
  }
}
